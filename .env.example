# AgroConnect — environment variables (template)
# Copy this file to `.env` (frontend) and fill in your own values.
# NEVER commit a real `.env` — it is git-ignored. Keys are rotated
# in the provider dashboards, never shared in the repo.

# --- Frontend (Vite, used in src/) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOV_DATA_API_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_ESCROW_API_URL=http://localhost:5001

# --- Backend (Server/ and backend/, used via process.env) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PORT=
NODE_ENV=
