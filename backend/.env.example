# Backend (escrow) — environment variables (template)
# Copy to .env and fill in your own values. Never commit a real .env.

PORT=
SUPABASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NODE_ENV=
SUPABASE_SERVICE_ROLE_KEY=
# CORS allowlist (comma-separated). Defaults already include the deployed
# production Vercel domains + localhost dev origins.
ALLOWED_ORIGINS=
FRONTEND_URL=
